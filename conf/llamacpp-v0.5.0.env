# llama.cpp version axis: tag v0.5.0.
#
# Owned here: the llama.cpp tag the source checkout is fetched at, and any
# build variable that exists only because this version needs it. A new
# llama.cpp release adds a file beside this one. Keys another axis owns belong
# in that axis's file, and a key here reaches the build only when it is an axis
# key or Dockerfile.rocm declares a matching ARG, so a typo cannot silently do
# nothing.

LLAMA_CPP_VERSION=v0.5.0

# The port the v0.5.0 image serves on. llama-server reads LLAMA_ARG_PORT as its
# --port; the official v0.5.0 build serves 8080. build-rocm.sh passes this
# value to the build as --build-arg.
LLAMA_ARG_PORT=8080
