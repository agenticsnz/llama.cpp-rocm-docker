# GPU axis: the discrete RDNA4 card in this machine.
#
# Owned here: anything that changes when the card changes. Nothing that changes
# when the ROCm release changes, and nothing that changes with neither.

GPU_TARGET=gfx1200
ARCH_STRING=gfx1200

# FlashAttention KV cache type combinations compiled into the image.
#
# `all` is the complete cross-product of the seven supported K/V types, which is
# 49 combinations. It is chosen because there is nothing to narrow for: research
# at v0.5.0 (commit 7fe450e) found no arch-dependent type gating anywhere in
# llama.cpp, and AMD publishes no per-architecture KV-cache quant recommendation
# that names these types. With no architecture-specific restriction to encode,
# compiling everything is the honest default and leaves no unjustified exclusion
# to discover later.
#
# OWNERSHIP IS JUDGEMENT, NOT MEASUREMENT. This key sits on the architecture axis
# because that axis is the home for per-GPU build tuning, not because
# FlashAttention quant-type support varies by architecture. The evidence is that
# it does not: the 49 vector template instances in
# ggml/src/ggml-cuda/template-instances/ carry no __CUDA_ARCH__ guards, type
# dispatch is plain `if constexpr` in get_vec_dot_KQ and get_dequantize_V, and
# ggml/cmake/common.cmake is byte-identical on master. So the axis assignment is
# a structural choice about where tuning belongs.
#
# Narrowing is a per-card decision, not a default, and this file is where one is
# taken. A measurement on a given card that shows a narrowing is worth its build
# cost can set an explicit list here. The accepted value space is the type list
# `q4_0 q4_1 q5_0 q5_1 q8_0 bf16 f16` (FA_TYPES in ggml/cmake/common.cmake); an
# entry is `<type_K>-<type_V>` with both sides drawn from it, or the literal
# `all`. An unknown type is a FATAL_ERROR, and so is an empty value, which is
# checked before `all` is considered. Input is lowercased and stripped, and
# commas work as separators as well as semicolons.
#
# The cost of `all` is build time and about 20 MB of object code, paid on every
# rebuild. Upstream's own default at this tag is the narrower
# `q4_0-q4_0;q8_0-q8_0;f16-f16;bf16-bf16`, so `all` is a deliberate superset
# rather than an inherited value. GGML_CUDA_FA_ALL_QUANTS is deliberately not
# set: it is deprecated upstream, warns at configure time, and is overridden to
# `all` anyway, so the spelling above expresses the same thing without a warning.
#
# Note that a narrowed list still cannot drop f16-f16. Upstream's
# ggml/cmake/common.cmake seeds it before applying whatever is written here, and
# ggml/src/ggml-cuda/fattn.cu uses it as the fallback for any K/V type with no
# compiled vector kernel, behind a GGML_ASSERT that aborts rather than degrades.
GGML_CUDA_FA_QUANTS=all
