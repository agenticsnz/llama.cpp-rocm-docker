# ROCm axis: release 7.14.1.
#
# Owned here: the base image, the release number, and the runtime behaviour
# particular to this release.

# The published multi-architecture image. AMD's per-family repository carries
# 7.11, 7.12 and 7.13 only, and the product-layout repository carries 10.0, so
# there is no per-architecture package set at 7.14 to assemble from.
ROCM_BASE=rocm/dev-ubuntu-24.04:7.14.1-full
ROCM_VERSION=7.14.1
ROCM_BASE_ASSEMBLY=published-multiarch-image
# Version-scoped install root inside the base (TheRock: core-<major.minor>).
# 7.14.0 and 7.14.1 share core-7.14, so this is not derivable from ROCM_VERSION
# by appending the full version.
ROCM_CORE_DIR=/opt/rocm/core-7.14

# Required on this base. It ships no /etc/ld.so.conf.d entry for ROCm, so
# ldconfig does not know about /opt/rocm/lib and libggml-hip.so cannot resolve
# libamdhip64.so.7. Without it the container starts, amd-smi reports the GPU
# and the healthcheck passes, but llama-server --list-devices prints (none).
LD_LIBRARY_PATH=/opt/rocm/lib
