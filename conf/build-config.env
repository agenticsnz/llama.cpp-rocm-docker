# Axis-neutral build configuration.
#
# Neither the GPU architecture nor the ROCm version changes any of these, so
# they are owned here rather than in either axis file. A key found in more than
# one file resolves to the file that owns its axis; these are the values that
# own no axis, so this file wins them.

CMAKE_BUILD_TYPE=Release
# No scheme. A Docker image reference never carries one, and the daemon rejects
# the whole reference if it does: `docker build --tag https://host:5001/x:1`
# fails with "invalid reference format". Whether this registry speaks http or
# https is the daemon's `insecure-registries` setting, not part of the reference.
# No trailing slash either: build-rocm.sh strips one with ${REGISTRY%/} before
# joining, so both spellings produce the same reference.
REGISTRY=ghcr.io
LLAMA_CPP_VERSION=v0.5.0
VERSION=1.1.0

# CPU backend would otherwise be tuned to whichever host compiled the image.
# Upstream's own release workflow passes the same value.
GGML_NATIVE=OFF
