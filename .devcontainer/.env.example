# Docker Compose environment variables

# Override the base image for the devcontainer
# Default: mcr.microsoft.com/devcontainers/base:ubuntu-24.04
# BASE_IMAGE=mcr.microsoft.com/devcontainers/base:ubuntu-24.04

# Git Configuration
GIT_USER_NAME=your_git_username
GIT_USER_EMAIL=your_git_email@example.com

# API Keys
# AGENTIC_API_KEY=your_api_key_here
